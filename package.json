{
  "name": "atelier",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "playground"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test \"*/src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p core && tsc --noEmit -p playground"
  },
  "engines": {
    "node": ">=24"
  }
}
